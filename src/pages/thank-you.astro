
---
const title = "Thank You for Your Purchase | TechWeMate";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>

  <body>
    <main class="container">
      <div class="success-icon">✓</div>

      <h1>Thank You for Your Purchase!</h1>
      <p class="subtitle">
        Thank you for choosing TechWeMate.
      </p>

      <section class="card">
        <h2>Access Your Digital Product</h2>
        <p>
          Once your payment is confirmed, please follow
          the delivery instructions provided by Digistore24
          to access your digital product.
        </p>
        <p>
          Check your email inbox and spam folder for
          your purchase confirmation and access details.
        </p>
      </section>

      <section class="card">
        <h2>Payment Information</h2>
        <p>The debit will be performed by Digistore24.com</p>
      </section>

      <section class="card">
        <h2>Need Help?</h2>
        <p>
          Contact our support team:
          <a href="mailto:admin@contenprodigital.com">
            admin@contenprodigital.com
          </a>
        </p>
      </section>

      <a href="/" class="button">Back to TechWeMate</a>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #0b1220;
    color: #f8fafc;
    font-family: Arial, sans-serif;
  }

  .container {
    max-width: 760px;
    margin: 60px auto;
    padding: 30px 24px;
    text-align: center;
  }

  .success-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    border-radius: 50%;
    background: #16a34a;
    display: grid;
    place-items: center;
    font-size: 44px;
    font-weight: bold;
  }

  h1 {
    font-size: clamp(28px, 5vw, 42px);
  }

  .subtitle {
    color: #cbd5e1;
    font-size: 18px;
  }

  .card {
    margin: 24px 0;
    padding: 25px;
    background: #172338;
    border: 1px solid #334155;
    border-radius: 14px;
    line-height: 1.7;
  }

  .card h2 {
    font-size: 22px;
  }

  .card p {
    color: #cbd5e1;
  }

  .card a {
    color: #60a5fa;
    overflow-wrap: anywhere;
  }

  .button {
    display: inline-block;
    margin-top: 20px;
    padding: 15px 28px;
    background: #2563eb;
    border-radius: 9px;
    color: white;
    font-weight: bold;
    text-decoration: none;
  }
</style>
