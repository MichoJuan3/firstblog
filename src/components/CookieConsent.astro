<div id="cookie-banner" hidden>
  <p>
    We use optional cookies and tracking technologies
    for analytics, advertising, and affiliate attribution.
  </p>
  <button id="cookie-accept" type="button">Accept All</button>
  <button id="cookie-reject" type="button">Reject Optional</button>
</div>

<style>
  #cookie-banner:not([hidden]) {
    position: fixed;
    bottom: 16px;
    left: 16px;
    right: 16px;
    max-width: 560px;
    margin: auto;
    padding: 20px;
    background: #14213d;
    color: white;
    border-radius: 12px;
    box-shadow: 0 6px 24px #0004;
    z-index: 9999;
  }

  #cookie-banner button {
    margin: 8px 8px 0 0;
    padding: 10px 16px;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }
</style>

<script is:inline>
  const banner = document.getElementById('cookie-banner');
  const savedConsent = localStorage.getItem('techwemate-consent');

  if (!savedConsent) {
    banner.hidden = false;
  }

  document.getElementById('cookie-accept').addEventListener('click', () => {
    localStorage.setItem('techwemate-consent', 'accepted');
    banner.hidden = true;
    window.location.reload();
  });

  document.getElementById('cookie-reject').addEventListener('click', () => {
    localStorage.setItem('techwemate-consent', 'rejected');
    banner.hidden = true;
    window.location.reload();
  });
</script>
