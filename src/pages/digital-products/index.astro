
---
const products = [
  {
    title: "The Entrepreneur's Time System",
    description: "A practical 6-in-1 digital bundle to improve productivity, planning, and time management.",
    category: "Productivity",
    url: "/digital-products/entrepreneurs-time-system/",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Digital Products & Resources | TechWeMate</title>
    <meta
      name="description"
      content="Explore digital ebooks, guides, and resources for entrepreneurs, freelancers, and online businesses."
    />
  </head>

  <body>
    <main>
      <header>
        <a href="/">TechWeMate</a>
        <h1>Digital Products & Resources</h1>
        <p>Practical resources to learn, build, and grow.</p>
      </header>

      <section class="products">
        {products.map((product) => (
          <article class="card">
            <span>{product.category}</span>
            <h2>{product.title}</h2>
            <p>{product.description}</p>
            <a href={product.url}>Explore Product →</a>
          </article>
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #0b1220;
    color: #f8fafc;
  }

  main {
    max-width: 1100px;
    margin: auto;
    padding: 50px 24px;
  }

  header {
    text-align: center;
    margin-bottom: 55px;
  }

  header a {
    color: #60a5fa;
    text-decoration: none;
    font-weight: bold;
  }

  h1 {
    font-size: clamp(30px, 5vw, 48px);
  }

  header p {
    color: #cbd5e1;
  }

  .products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .card {
    padding: 28px;
    background: #172338;
    border: 1px solid #334155;
    border-radius: 16px;
  }

  .card span {
    color: #93c5fd;
    font-size: 14px;
  }

  .card p {
    color: #cbd5e1;
    line-height: 1.7;
  }

  .card a {
    color: #60a5fa;
    font-weight: bold;
    text-decoration: none;
  }
</style>
