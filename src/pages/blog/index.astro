
---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import '../../styles/redesign.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Blog | ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
  </head>

  <body>
    <Header />

    <main class="tw-home">
      <section class="tw-blog-intro">
        <p class="tw-eyebrow">TECHWEMATE BLOG</p>
        <h1>Ideas, Tools & Guides for Digital Growth</h1>
        <p>
          Explore practical strategies for affiliate marketing,
          digital products, dropshipping, and online business.
        </p>
      </section>

      <section class="tw-section" aria-label="Featured digital guide">
        <div class="product-content">
          <div class="product-label">TECHWEMATE DIGITAL GUIDE</div>

          <h2>AI Prompt Mastery</h2>

          <p class="product-description">
            The Practical Guide to Getting Better Results with AI.
            Learn how to write clearer prompts, structure instructions,
            improve AI responses, and apply practical prompting techniques
            to everyday tasks.
          </p>

          <div class="product-actions">
            <a
              href="https://website.beacons.ai/techwemate"
              class="product-button"
            >
              Get Instant Access
            </a>

            <a href="/ai-prompt-mastery" class="product-link">
              See What's Inside →
            </a>
          </div>

          <span class="product-note">
            Instant digital access · PDF ebook · $19.97
          </span>
        </div>
      </section>

      <section class="tw-section">
        <h2>All Articles</h2>

        <div class="tw-article-grid">
          {posts.map((post) => (
            <article class="tw-article-card">
              <a href={`/blog/${post.data.slug || post.id}/`}>
                {post.data.coverImage && (
                  <Image
                    src={post.data.coverImage.src}
                    alt={post.data.coverImage.alt}
                    width={720}
                    height={405}
                  />
                )}
              </a>

              <div class="tw-card-content">
                <h3>
                  <a href={`/blog/${post.data.slug || post.id}/`}>
                    {post.data.title}
                  </a>
                </h3>

                <p>{post.data.description}</p>

                <p class="tw-article-date">
                  <FormattedDate date={post.data.pubDate} />
                </p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .tw-blog-intro {
    padding: 48px 0 12px;
    max-width: 850px;
  }

  .tw-eyebrow {
    color: #2563eb;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .tw-blog-intro h1 {
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.15;
    color: #0f172a;
  }

  .tw-blog-intro > p:last-child {
    color: #64748b;
    font-size: 18px;
  }

  .tw-article-date {
    font-size: 13px;
    color: #64748b;
    margin-top: 18px;
  }
</style>
