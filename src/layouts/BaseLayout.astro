---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <meta name="google-adsense-account" content="ca-pub-1006823992160276" />
    <meta name="msvalidate.01" content="4B19D293E3626B8ACC7A17648354ABD2" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1006823992160276"
     crossorigin="anonymous"></script>
     <meta name="impact-site-verification" value="b70ad17f-6087-4d16-9bbf-6ff709ffab09">
     <meta name='impact-site-verification' value='8c4acc89-d5ce-4b61-a422-1765b688e569'>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TWPHVPLG"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    <Header />
    <main>
      <slot /> <!-- Page content will be rendered here -->
    </main>
    <Footer />
  </body>
</html>
