
---
const pageTitle = 'Oeil Social | Votre argent, sans frontières';
const pageDescription =
  'Découvrez les comptes multidevises, les transferts internationaux et les solutions financières digitales avec Oeil Social.';

const wiseUrl = 'https://wise.com/invite/dic/jeanpaulm16';
const tiktokUrl = 'https://www.tiktok.com/@oeilsocial';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#100d1d" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <title>{pageTitle}</title>
  </head>

  <body>
<header>
  <nav class="container nav" aria-label="Main navigation">
    <a class="logo" href="/">
      TECH<span>WEMATE</span>
    </a>

    <div class="nav-actions">
      <a
        class="nav-link"
        href="https://www.tiktok.com/@oeilsocial"
        target="_blank"
        rel="noopener noreferrer"
      >
        TikTok ↗
      </a>

<div class="language-switch" aria-label="Langue">
  <a href="/digital-finance/" lang="en">EN</a>
  <span aria-hidden="true">|</span>
  <a href="/fr/finance-digitale/" lang="fr" aria-current="page">FR</a>
</div>

    </div>
  </nav>
</header>

    <main>
      <section class="hero">
        <div class="container">
          <span class="eyebrow">
            🌍 Finance digitale & transferts internationaux
          </span>

          <h1>
            Votre argent,<br />
            <span class="gradient">sans frontières.</span>
          </h1>

          <p>
            Créez votre compte multidevise et découvrez
            comment recevoir de l'argent depuis différents
            pays, selon votre éligibilité.
            Explorez une nouvelle façon de gérer
            vos finances internationales.
          </p>

          <a class="btn" href={wiseUrl}
            target="_blank"
            rel="noopener noreferrer sponsored">
            🌍 Créer mon compte multidevise ↗
          </a>

          <p class="disclosure">
            Lien de parrainage Wise.
            Disponibilité selon votre pays.
          </p>
        </div>
      </section>

      <section class="content" id="solutions">
        <div class="container">
          <div class="section-heading">
            <h2>Explorez les solutions financières digitales</h2>
            <p>
              Découvrez des ressources pour mieux comprendre
              les paiements internationaux et les outils
              financiers numériques.
            </p>
          </div>

          <div class="grid">
            <article class="card">
              <div class="card-icon">🌐</div>
              <h3>Transferts internationaux</h3>
              <p>
                Découvrez des solutions pour envoyer
                de l'argent à l'international et
                comparer les frais applicables.
              </p>
            </article>

            <article class="card">
              <div class="card-icon">💳</div>
              <h3>Comptes multidevises</h3>
              <p>
                Explorez les fonctionnalités permettant
                de détenir et gérer différentes devises,
                selon les pays éligibles.
              </p>
            </article>

            <article class="card">
              <div class="card-icon">💻</div>
              <h3>Paiements en ligne</h3>
              <p>
                Informez-vous sur les outils utiles
                aux freelances, entrepreneurs et
                professionnels du digital.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="content" id="wise">
        <div class="container">
          <div class="feature">
            <span class="eyebrow">Notre découverte</span>
            <h2>Découvrez Wise</h2>
            <p>
              Wise propose des services de transferts
              internationaux et des fonctionnalités
              multidevises dans les pays éligibles.
              Consultez directement les conditions,
              les frais et les possibilités de
              réception de fonds.
            </p>
            <a class="btn" href={wiseUrl}
              target="_blank"
              rel="noopener noreferrer sponsored">
              💸 Découvrir Wise ↗
            </a>
            <p class="disclosure">
              Lien de parrainage.
              Oeil Social est indépendant de Wise.
            </p>
          </div>
        </div>
      </section>

      <section class="content">
        <div class="container">
          <div class="section-heading">
            <h2>Comment commencer ?</h2>
            <p>Trois étapes simples pour découvrir les services.</p>
          </div>

          <div class="steps">
            <div class="step">
              <span class="step-number">ÉTAPE 01</span>
              <h3>Découvrez Wise</h3>
              <p>Accédez au site officiel via notre lien de parrainage.</p>
            </div>
            <div class="step">
              <span class="step-number">ÉTAPE 02</span>
              <h3>Vérifiez votre éligibilité</h3>
              <p>
                Consultez les services disponibles dans votre
                pays et les conditions de vérification d'identité.
              </p>
            </div>
            <div class="step">
              <span class="step-number">ÉTAPE 03</span>
              <h3>Explorez les fonctionnalités</h3>
              <p>
                Si vous êtes éligible, découvrez les transferts
                et les options multidevises proposées.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="content">
        <div class="container">
          <div class="social">
            <h2>Retrouvez Oeil Social sur TikTok</h2>
            <p>
              Conseils, découvertes et ressources autour
              de la finance digitale et des opportunités en ligne.
            </p>
            <a class="btn btn-outline" href={tiktokUrl}
              target="_blank" rel="noopener noreferrer">
              🎵 Suivre @oeilsocial sur TikTok ↗
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        <div class="logo">OEIL <span>SOCIAL</span></div>
        <p>
          Oeil Social est un site indépendant d'information.
          Il n'est pas officiellement affilié à Wise.
        </p>
        <p>
          Certains liens sont des liens de parrainage.
          Nous pouvons recevoir une récompense lorsque vous
          utilisez ces liens. Les services sont soumis aux
          conditions des fournisseurs et à leur disponibilité
          géographique.
        </p>
        <p>
          Les informations publiées ne constituent pas
          des conseils financiers personnalisés.
        </p>
        <p>© {new Date().getFullYear()} Oeil Social. Tous droits réservés.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #100d1d;
    --surface: #1b1730;
    --surface2: #29213f;
    --primary: #9657f5;
    --primary2: #7540d4;
    --text: #ffffff;
    --muted: #c9c1da;
    --border: #403452;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Inter, Arial, sans-serif;
    line-height: 1.65;
  }

  a { color: inherit; }

  .container {
    width: min(100% - 36px, 1060px);
    margin: auto;
  }

  header {
    border-bottom: 1px solid var(--border);
    background: #100d1d;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    gap: 15px;
  }

  .logo {
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-decoration: none;
  }

  .logo span { color: #b58bff; }

  .nav-link {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
  }

  .hero {
    text-align: center;
    padding: 95px 0 80px;
    background: radial-gradient(
      ellipse at 50% 10%,
      rgba(150, 87, 245, .20),
      transparent 60%
    );
  }

  .eyebrow {
    display: inline-block;
    padding: 7px 15px;
    background: #302149;
    border: 1px solid #5b3d88;
    border-radius: 30px;
    color: #d4bbff;
    font-size: 13px;
    font-weight: 700;
  }

  h1 {
    font-size: clamp(38px, 7vw, 68px);
    line-height: 1.12;
    letter-spacing: -1.8px;
    margin: 27px 0;
  }

  .gradient { color: #bd97ff; }

  .hero p {
    max-width: 680px;
    margin: 0 auto 30px;
    color: var(--muted);
    font-size: 18px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 9px;
    min-height: 54px;
    padding: 14px 25px;
    border-radius: 12px;
    background: var(--primary);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    transition: background .2s, transform .2s;
  }

  .btn:hover,
  .btn:focus-visible {
    background: var(--primary2);
    transform: translateY(-2px);
  }

  .btn-outline {
    background: transparent;
    border: 1px solid #8661bc;
  }

  .btn-outline:hover { background: #322448; }

  .disclosure {
    font-size: 13px !important;
    color: #b7a9cc !important;
    margin-top: 15px !important;
  }

  section.content { padding: 45px 0; }

  .section-heading {
    text-align: center;
    margin-bottom: 32px;
  }

  h2 {
    font-size: clamp(27px, 4vw, 36px);
    line-height: 1.25;
    margin: 0 0 15px;
  }

  .section-heading p {
    color: var(--muted);
    max-width: 650px;
    margin: auto;
  }

  .grid, .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 28px;
  }

  .card-icon {
    font-size: 32px;
    margin-bottom: 15px;
  }

  h3 {
    margin: 0 0 12px;
    font-size: 20px;
  }

  .card p, .feature p, .step p {
    color: var(--muted);
  }

  .feature {
    background: linear-gradient(135deg, #29203f, #1b1730);
    border: 1px solid #59417c;
    border-radius: 24px;
    padding: 45px;
    text-align: center;
  }

  .feature h2 { margin-top: 22px; }

  .feature p {
    max-width: 680px;
    margin: 0 auto 25px;
  }

  .step {
    padding: 25px;
    border-left: 3px solid var(--primary);
    background: var(--surface);
    border-radius: 12px;
  }

  .step-number {
    font-size: 13px;
    color: #c9a9ff;
    font-weight: bold;
  }

  .step h3 { margin-top: 10px; }

  .social {
    text-align: center;
    padding: 40px;
    background: var(--surface2);
    border-radius: 20px;
  }

  .social p { color: var(--muted); }

  footer {
    margin-top: 60px;
    padding: 35px 0;
    border-top: 1px solid var(--border);
    text-align: center;
    color: var(--muted);
    font-size: 13px;
  }

  footer p {
    max-width: 760px;
    margin: 12px auto;
  }

  @media (max-width: 760px) {
    .grid, .steps { grid-template-columns: 1fr; }
    .hero { padding: 65px 0; }
    .hero p { font-size: 16px; }
    .feature, .social { padding: 28px 20px; }
    .btn { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .btn { transition: none; }
  }


.nav-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.language-switch {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 14px;
  border: 1px solid #9355e9;
  border-radius: 10px;
}

.language-switch a {
  color: #c4b5fd;
  font-weight: 700;
  text-decoration: none;
}

.language-switch a[aria-current="page"] {
  color: #ffffff;
}

.language-switch a:hover {
  color: #ffffff;
}

@media (max-width: 520px) {
  .nav-actions {
    gap: 10px;
  }

  .language-switch {
    gap: 7px;
    padding: 7px 10px;
  }
}
</style>