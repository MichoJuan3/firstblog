
---
const pageTitle = 'Digital Finance | Money Without Borders | TechWeMate';
const pageDescription =
  'Explore multi-currency accounts, international money transfers, and digital financial solutions with TechWeMate.';

const wiseUrl = 'https://wise.com/invite/dic/jeanpaulm16';
const tiktokUrl = 'https://www.tiktok.com/@oeilsocial';
---

<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#100d1d" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <title>{pageTitle}</title>
  </head>

  <body>
<header>
  <nav class="container nav" aria-label="Main navigation">
    <a class="logo" href="/">
      TECH<span>WEMATE</span>
    </a>

    <div class="nav-actions">
      <a
        class="nav-link"
        href="https://www.tiktok.com/@oeilsocial"
        target="_blank"
        rel="noopener noreferrer"
      >
        TikTok ↗
      </a>


<div class="language-switch" aria-label="Language">
  <a href="/digital-finance/" lang="en" aria-current="page">EN</a>
  <span aria-hidden="true">|</span>
  <a href="/fr/finance-digitale/" lang="fr">FR</a>
</div>

    </div>
  </nav>
</header>

    <main>
      
<section class="hero">
  <div class="container">
    <span class="eyebrow">
      🌍 Digital Finance & International Transfers
    </span>

    <h1>
      Your Money,<br />
      <span class="gradient">Without Borders.</span>
    </h1>

    <p>
      Explore multi-currency accounts and discover how
      to receive money from different countries, subject
      to your eligibility. Discover a smarter way to
      manage your international finances.
    </p>

    <a
      class="btn"
      href={wiseUrl}
      target="_blank"
      rel="noopener noreferrer sponsored"
    >
      🌍 Open My Multi-Currency Account ↗
    </a>

    <p class="disclosure">
      Wise referral link.
      Availability varies by country.
    </p>
  </div>
</section>


      
<section class="content" id="solutions">
  <div class="container">
    <div class="section-heading">
      <h2>Explore Digital Financial Solutions</h2>
      <p>
        Discover resources to better understand
        international payments and digital financial tools.
      </p>
    </div>

    <div class="grid">
      <article class="card">
        <div class="card-icon">🌐</div>
        <h3>International Money Transfers</h3>
        <p>
          Explore solutions for sending money internationally
          and comparing applicable transfer fees.
        </p>
      </article>

      <article class="card">
        <div class="card-icon">💳</div>
        <h3>Multi-Currency Accounts</h3>
        <p>
          Discover features that allow you to hold
          and manage multiple currencies,
          depending on your country of eligibility.
        </p>
      </article>

      <article class="card">
        <div class="card-icon">💻</div>
        <h3>Online Payments</h3>
        <p>
          Learn about useful payment tools for
          freelancers, entrepreneurs, and
          digital professionals.
        </p>
      </article>
    </div>
  </div>
</section>


      
<section class="content" id="wise">
  <div class="container">
    <div class="feature">
      <span class="eyebrow">Featured Solution</span>

      <h2>Discover Wise</h2>

      <p>
        Wise offers international money transfer services
        and multi-currency features in eligible countries.
        Check the official website for available services,
        applicable fees, and options for receiving money.
      </p>

      <a
        class="btn"
        href={wiseUrl}
        target="_blank"
        rel="noopener noreferrer sponsored"
      >
        💸 Explore Wise ↗
      </a>

      <p class="disclosure">
        Wise referral link.
        Oeil Social is independent of Wise.
      </p>
    </div>
  </div>
</section>


      
<section class="content">
  <div class="container">
    <div class="section-heading">
      <h2>How to Get Started</h2>
      <p>
        Three simple steps to explore digital
        financial services.
      </p>
    </div>

    <div class="steps">
      <div class="step">
        <span class="step-number">STEP 01</span>
        <h3>Discover Wise</h3>
        <p>
          Visit the official Wise website
          through our referral link.
        </p>
      </div>

      <div class="step">
        <span class="step-number">STEP 02</span>
        <h3>Check Your Eligibility</h3>
        <p>
          Review the services available in your
          country and the identity verification
          requirements.
        </p>
      </div>

      <div class="step">
        <span class="step-number">STEP 03</span>
        <h3>Explore the Features</h3>
        <p>
          If eligible, discover international
          transfers and multi-currency options
          offered by Wise.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="content">
  <div class="container">
    <div class="social">
      <h2>Follow Oeil Social on TikTok</h2>

      <p>
        Discover tips, insights, and useful resources
        about digital finance and online opportunities.
      </p>

      <a
        class="btn btn-outline"
        href={tiktokUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        🎵 Follow @oeilsocial on TikTok ↗
      </a>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="container">
    <div class="logo">
      TECH<span>WEMATE</span>
    </div>

    <p>
      TechWeMate is an independent information website
      and is not officially affiliated with Wise.
    </p>

    <p>
      Some links on this page are referral links.
      We may receive a reward when you use these links.
      Services are subject to provider terms
      and geographic availability.
    </p>

    <p>
      The information published on this website
      does not constitute personalized financial advice.
    </p>

    <p>
      © {new Date().getFullYear()} TechWeMate.
      All rights reserved.
    </p>
  </div>
</footer>

</body>
</html>


<style is:global>
  :root {
    color-scheme: dark;
    --bg: #100d1d;
    --surface: #1b1730;
    --surface2: #29213f;
    --primary: #9657f5;
    --primary2: #7540d4;
    --text: #ffffff;
    --muted: #c9c1da;
    --border: #403452;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Inter, Arial, sans-serif;
    line-height: 1.65;
  }

  a { color: inherit; }

  .container {
    width: min(100% - 36px, 1060px);
    margin: auto;
  }

  header {
    border-bottom: 1px solid var(--border);
    background: #100d1d;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    gap: 15px;
  }

  .logo {
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-decoration: none;
  }

  .logo span { color: #b58bff; }

  .nav-link {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
  }

  .hero {
    text-align: center;
    padding: 95px 0 80px;
    background: radial-gradient(
      ellipse at 50% 10%,
      rgba(150, 87, 245, .20),
      transparent 60%
    );
  }

  .eyebrow {
    display: inline-block;
    padding: 7px 15px;
    background: #302149;
    border: 1px solid #5b3d88;
    border-radius: 30px;
    color: #d4bbff;
    font-size: 13px;
    font-weight: 700;
  }

  h1 {
    font-size: clamp(38px, 7vw, 68px);
    line-height: 1.12;
    letter-spacing: -1.8px;
    margin: 27px 0;
  }

  .gradient { color: #bd97ff; }

  .hero p {
    max-width: 680px;
    margin: 0 auto 30px;
    color: var(--muted);
    font-size: 18px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 9px;
    min-height: 54px;
    padding: 14px 25px;
    border-radius: 12px;
    background: var(--primary);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    transition: background .2s, transform .2s;
  }

  .btn:hover,
  .btn:focus-visible {
    background: var(--primary2);
    transform: translateY(-2px);
  }

  .btn-outline {
    background: transparent;
    border: 1px solid #8661bc;
  }

  .btn-outline:hover { background: #322448; }

  .disclosure {
    font-size: 13px !important;
    color: #b7a9cc !important;
    margin-top: 15px !important;
  }

  section.content { padding: 45px 0; }

  .section-heading {
    text-align: center;
    margin-bottom: 32px;
  }

  h2 {
    font-size: clamp(27px, 4vw, 36px);
    line-height: 1.25;
    margin: 0 0 15px;
  }

  .section-heading p {
    color: var(--muted);
    max-width: 650px;
    margin: auto;
  }

  .grid, .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 28px;
  }

  .card-icon {
    font-size: 32px;
    margin-bottom: 15px;
  }

  h3 {
    margin: 0 0 12px;
    font-size: 20px;
  }

  .card p, .feature p, .step p {
    color: var(--muted);
  }

  .feature {
    background: linear-gradient(135deg, #29203f, #1b1730);
    border: 1px solid #59417c;
    border-radius: 24px;
    padding: 45px;
    text-align: center;
  }

  .feature h2 { margin-top: 22px; }

  .feature p {
    max-width: 680px;
    margin: 0 auto 25px;
  }

  .step {
    padding: 25px;
    border-left: 3px solid var(--primary);
    background: var(--surface);
    border-radius: 12px;
  }

  .step-number {
    font-size: 13px;
    color: #c9a9ff;
    font-weight: bold;
  }

  .step h3 { margin-top: 10px; }

  .social {
    text-align: center;
    padding: 40px;
    background: var(--surface2);
    border-radius: 20px;
  }

  .social p { color: var(--muted); }

  footer {
    margin-top: 60px;
    padding: 35px 0;
    border-top: 1px solid var(--border);
    text-align: center;
    color: var(--muted);
    font-size: 13px;
  }

  footer p {
    max-width: 760px;
    margin: 12px auto;
  }

  @media (max-width: 760px) {
    .grid, .steps { grid-template-columns: 1fr; }
    .hero { padding: 65px 0; }
    .hero p { font-size: 16px; }
    .feature, .social { padding: 28px 20px; }
    .btn { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .btn { transition: none; }
  }


.nav-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.language-switch {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 14px;
  border: 1px solid #9355e9;
  border-radius: 10px;
}

.language-switch a {
  color: #c4b5fd;
  font-weight: 700;
  text-decoration: none;
}

.language-switch a[aria-current="page"] {
  color: #ffffff;
}

.language-switch a:hover {
  color: #ffffff;
}

@media (max-width: 520px) {
  .nav-actions {
    gap: 10px;
  }

  .language-switch {
    gap: 7px;
    padding: 7px 10px;
  }
}
</style>