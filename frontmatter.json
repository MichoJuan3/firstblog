{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.custom.scripts": [
    {
      "id": "push-git",
      "title": "Push on GitHub",
      "script": "./scripts/git-push.ps1",
      "command": "powershell",
      "type": "content"
    }
  ],
  "frontMatter.framework.id": "astro",
  "frontMatter.preview.host": "http://localhost:4321",
  "frontMatter.content.publicFolder": "public",
  "frontMatter.media.folder": "src/assets/images",
  "frontMatter.content.pageFolders": [
    {
      "title": "blog",
      "path": "[[workspace]]/src/content/blog"
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "previewPath": "'blog'",
      "filePrefix": null,
      "clearEmpty": true,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "single": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Publishing date",
          "name": "pubDate",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "Author",
          "name": "author",
          "type": "string",
          "default": "Jean Paul Michel"
        },
        {
          "title": "Cover Image",
          "name": "coverImage",
          "type": "fields",
          "fields": [
            {
              "title": "Image File",
              "name": "src",
              "type": "image",
              "isPreviewImage": true
            },
            {
              "title": "Alt Text",
              "name": "alt",
              "type": "string"
            }
          ]
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Category",
          "name": "category",
          "type": "categories"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "boolean",
          "default": false
        }
      ]
    }
  ]
}