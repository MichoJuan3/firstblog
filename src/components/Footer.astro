---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Jean Paul Michel. All rights reserved.
	<div class="payhip-cta"><a href="https://shop.contenprodigital.com" class="payhip-shop-link" target="_blank" rel="noopener">Shop All Products</a></div>
        <div class="legal-links">
		<a href="/privacy-policy">Privacy Policy</a>
		<a href="/terms">Terms</a>
		<a href="/affiliate-disclosure">Affiliate Disclosure</a>
		<a href="https://www.contenprodigital.com/techwemate-links" target="_blank" rel="noopener">My Tools & Resources</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.legal-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 0.75em;
	}
	.legal-links a {
		text-decoration: none;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
	.legal-links a:hover {
		color: rgb(var(--gray-dark));
		text-decoration: underline;
	}
        .payhip-shop-link {
                display: inline-block;
                background: #2e8b57;
                color: white;
                padding: 0.6em 1.4em;
                border-radius: 6px;
                text-decoration: none;
                font-weight: bold;
        }
        .payhip-shop-link:hover {
                background: #256e46;
        }
</style>
